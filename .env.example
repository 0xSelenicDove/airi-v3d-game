# Copy to .env.local and edit. Any OpenAI-compatible chat-completions endpoint works.
# Ollama:    http://localhost:11434/v1/chat/completions
# LM Studio: http://localhost:1234/v1/chat/completions
VITE_LLM_URL=http://localhost:11434/v1/chat/completions
VITE_LLM_MODEL=your-model-name
# VITE_LLM_KEY=
# Send instructions as a real system message (default: inside the user message, which more models follow reliably)
# VITE_LLM_SYSTEM_ROLE=1
